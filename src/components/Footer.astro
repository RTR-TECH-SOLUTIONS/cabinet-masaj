---
import { nav, site } from '../data/site';
---

<footer class="bg-night pb-28 pt-14 text-[#d8cdbd] md:pb-12">
  <div class="wrap grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-serif text-[2.75rem] font-semibold leading-none text-white">{site.name}</p>
      <p class="mt-3 max-w-xs text-[0.9688rem]">
        Cabinet de masaj cu un singur terapeut, în {site.area}. Se lucrează doar cu programare.
      </p>
    </div>
    <div class="text-[0.9688rem]">
      <p class="mb-3 font-semibold text-white">Cabinet</p>
      <p>{site.address}</p>
      <p class="mt-2">
        <a href={site.phoneHref} class="text-white underline decoration-[#87552e] underline-offset-4">{site.phoneDisplay}</a>
      </p>
      <p>{site.email}</p>
    </div>
    <div class="text-[0.9688rem]">
      <p class="mb-3 font-semibold text-white">Pe pagină</p>
      <ul class="space-y-1.5">
        {nav.map((item) => (
          <li><a href={item.href} class="no-underline hover:text-white hover:underline">{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap mt-12 border-t border-white/15 pt-6 text-[0.8438rem] text-[#a99b89]">
    © {new Date().getFullYear()} {site.name}. {site.therapist}, tehnician maseur autorizat.
  </div>
</footer>
