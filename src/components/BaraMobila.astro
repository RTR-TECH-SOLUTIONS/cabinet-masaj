---
import WaIcon from './WaIcon.astro';
import { site, waDefault } from '../data/site';
---

<!-- Mobil: bară fixă jos. Desktop: buton WhatsApp în colț. -->
<div class="bara">
  <a href={site.phoneHref} class="bara-btn bara-tel">Sună</a>
  <a href={waDefault} target="_blank" rel="noopener" class="bara-btn bara-wa" data-wa-link>
    <WaIcon size={18} />
    Programare pe WhatsApp
  </a>
</div>

<a href={waDefault} target="_blank" rel="noopener" class="wa-colt" aria-label="Scrie pe WhatsApp" data-wa-link>
  <WaIcon size={26} />
</a>

<style>
  .bara {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem calc(0.625rem + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--color-paper) 96%, transparent);
    border-top: 1px solid var(--color-line);
    backdrop-filter: blur(8px);

    @media (min-width: 768px) { display: none; }
  }

  .bara-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding-inline: 1.25rem;
    border-radius: var(--radius-btn);
    font-weight: 600;
    font-size: 0.9688rem;
    text-decoration: none;
  }

  .bara-tel {
    border: 1.5px solid var(--color-ink);
    color: var(--color-ink);
  }

  .bara-wa {
    background: var(--color-bronze);
    color: #fff;
  }

  .wa-colt {
    display: none;

    @media (min-width: 768px) {
      position: fixed;
      right: 1.5rem;
      bottom: 1.5rem;
      z-index: 40;
      display: grid;
      place-items: center;
      width: 3.5rem;
      height: 3.5rem;
      border-radius: 50%;
      background: var(--color-ink);
      color: #fff;
      box-shadow: 0 1px 2px rgb(33 23 15 / 0.2), 0 8px 24px rgb(33 23 15 / 0.18);
      transition: transform 180ms ease-out, background-color 180ms ease-out;

      &:hover {
        background: var(--color-bronze);
        transform: translateY(-2px);
      }
    }
  }
</style>
