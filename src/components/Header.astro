---
import { nav, site, waDefault } from '../data/site';
---

<header class="site-header" data-header>
  <div class="wrap flex h-full items-center justify-between gap-6">
    <a href="#top" class="flex items-baseline gap-2.5 no-underline" aria-label={`${site.name}, ${site.descriptor}`}>
      <span class="font-serif text-[2.25rem] font-semibold leading-none">{site.name}</span>
      <span class="hidden text-[0.8125rem] text-ink-soft sm:inline">{site.descriptor}, {site.city}</span>
    </a>

    <nav class="hidden lg:block" aria-label="Meniu principal">
      <ul class="flex items-center gap-8 text-[0.9688rem] font-medium">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="nav-link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-5">
      <a href={site.phoneHref} class="hidden text-[0.9688rem] font-semibold tabular-nums no-underline hover:underline md:inline">
        {site.phoneDisplay}
      </a>
      <a href={waDefault} target="_blank" rel="noopener" class="btn hidden !min-h-11 !px-5 !text-[0.9375rem] sm:inline-flex">
        Programează-te
      </a>
      <button
        type="button"
        class="menu-btn"
        aria-expanded="false"
        aria-controls="meniu-mobil"
        data-menu-btn
      >
        <span class="sr-only">Deschide meniul</span>
        <span class="menu-lines" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="meniu-mobil" class="mobile-panel" hidden data-menu-panel>
    <nav class="wrap pb-8 pt-2" aria-label="Meniu mobil">
      <ul>
        {nav.map((item) => (
          <li class="border-b border-line">
            <a href={item.href} class="block py-4 font-serif text-[2rem] font-medium leading-none no-underline" data-menu-link>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-ink-soft">
        {site.address}<br />
        <a href={site.phoneHref} class="link">{site.phoneDisplay}</a>
      </p>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 200ms ease-out, border-color 200ms ease-out;

    &[data-solid],
    &[data-open] {
      background: color-mix(in srgb, var(--color-paper) 96%, transparent);
      border-bottom-color: var(--color-line);
      backdrop-filter: blur(8px);
    }
  }

  .nav-link {
    text-decoration: none;
    padding-block: 0.375rem;
    border-bottom: 1.5px solid transparent;
    transition: border-color 180ms ease-out;

    &:hover { border-bottom-color: var(--color-bronze); }
  }

  .menu-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;

    @media (min-width: 1024px) { display: none; }
  }

  .menu-lines,
  .menu-lines::before,
  .menu-lines::after {
    display: block;
    width: 1.5rem;
    height: 1.5px;
    background: var(--color-ink);
    transition: transform 200ms ease-out, background-color 200ms ease-out;
  }

  .menu-lines {
    position: relative;

    &::before, &::after {
      content: "";
      position: absolute;
      left: 0;
    }
    &::before { top: -7px; }
    &::after { top: 7px; }
  }

  [aria-expanded="true"] .menu-lines {
    background: transparent;

    &::before { transform: translateY(7px) rotate(45deg); }
    &::after { transform: translateY(-7px) rotate(-45deg); }
  }

  .mobile-panel {
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;

    @media (min-width: 1024px) { display: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  const onScroll = () => header?.toggleAttribute('data-solid', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!btn || !panel || !header) return;
    btn.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    header.toggleAttribute('data-open', open);
  };

  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  document.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
